# === Telegram API ===
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# === Channel Configuration ===
# Main channel ID where files are uploaded (required)
TELEGRAM_CHANNEL_ID=

# Backup channel ID — files auto-forward here after upload (optional)
BACKUP_CHANNEL_ID=

# === Server ===
PORT=8080
HOST=0.0.0.0

# === Render Deployment ===
# Set automatically by Render: RENDER_EXTERNAL_URL
# For non-Render: set KEEP_ALIVE_URL to your public URL
KEEP_ALIVE_URL=

# === Frontend ===
# Path to built frontend files
FRONTEND_DIST=../frontend/dist

# === Session ===
SESSION_PATH=telegram.session

# === Settings ===
SETTINGS_PATH=settings.json

# === AI Proxy ===
AI_PROXY_URL=

# === Backup Sync ===
# How often (seconds) to check for backup sync
BACKUP_SYNC_INTERVAL=30

# === Upload ===
# Max upload size in bytes (default 5GB)
MAX_UPLOAD_SIZE=5368709120
